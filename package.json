{
  "name": "sunflowertrip",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:ssr": "ng build --configuration production",
    "serve:ssr": "node dist/sunflowertrip/server/server.mjs",
    "prerender": "ng build --configuration production --ssr",
    "dev:ssr": "nodemon --watch src --exec \"ng build && node dist/sunflowertrip/server/server.mjs\""
  },
